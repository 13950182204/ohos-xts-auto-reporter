{
  "name": "ohos-xts-auto-reporter",
  "version": "0.3.2",
  "description": "OpenHarmony XTS 兼容性测试自动上报 DSH 插件：Host + Web client，第二阶段只保存草稿绝不提交",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && pnpm exec tsdown --config tsdown.config.ts && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s test -v"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "js-yaml": "^4.1.0",
    "playwright": "^1.62.1",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@yeesy369/dsh-browser": "0.5.1",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
